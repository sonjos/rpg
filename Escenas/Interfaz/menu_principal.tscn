[sub_resource type="GDScript" id="GDScript_ft1ng"]
script/source = "extends Control

@export_file(\"*.tscn\") var escena_juego: String = \"res://Escenas/escenarios/mundo.tscn\"

@onready var boton_jugar: Button = $VBoxContainer/Jugar
@onready var boton_salir: Button = $VBoxContainer/Salir
@onready var caja_lore: PanelContainer = $Lore/CajaLore

func _ready() -> void:
	boton_jugar.pressed.connect(_on_jugar_pressed)
	boton_salir.pressed.connect(_on_salir_pressed)
	# Opcional: si tienes un botón dentro del lore para continuar
	# $CajaLore/BotonContinuar.pressed.connect(_iniciar_juego)

func _on_salir_pressed() -> void:
	get_tree().quit()
	
func _on_jugar_pressed() -> void:
	# Ocultamos el menú inicial y mostramos el Lore
	boton_jugar.hide()
	boton_salir.hide()
	caja_lore.show()

# Esta función se llamaría al pulsar un botón o tecla dentro del Lore
func _iniciar_juego() -> void:
	# Esto carga tu escena de juego (ajusta la ruta si es necesario)
	get_tree().change_scene_to_file(\"res://Escenas/escenarios/mundo.tscn\")

func _input(event: InputEvent) -> void:
	# Solo salta al juego si el lore está visible y se presiona una tecla
	if caja_lore.visible and event is InputEventKey and event.pressed:
		_iniciar_juego()
"

